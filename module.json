{
  "id": "magic-item-tracker",
  "title": "Magic Item Tracker",
  "description": "Tracks magic items awarded and purchased against the 2024 DMG Magic Item Tracker targets, by level range and rarity.",
  "version": "1.0.0",
  "authors": [{ "name": "Barry Davis", "url": "https://github.com/bdavis19" }],
  "url": "https://github.com/bdavis19/magic-item-tracker",
  "bugs": "https://github.com/bdavis19/magic-item-tracker/issues",
  "manifest": "https://github.com/bdavis19/magic-item-tracker/releases/latest/download/module.json",
  "download": "https://github.com/bdavis19/magic-item-tracker/releases/download/v1.0.0/module.zip",
  "license": "LICENSE",
  "readme": "README.md",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      { "id": "dnd5e", "type": "system", "compatibility": { "minimum": "6.0" } }
    ],
    "recommends": [
      { "id": "item-piles", "type": "module", "reason": "Logs merchant purchases and loot pile pickups automatically." },
      { "id": "ddb-importer", "type": "module", "reason": "Re-links logged items after D&D Beyond character re-imports." }
    ]
  },
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/tracker.css"]
}